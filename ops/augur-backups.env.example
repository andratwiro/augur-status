# Copy to /etc/augur-backups.d/<instance>.env, chmod 600. Never commit the real one.
#
# One file per instance; run-backups.sh sources each in its own subshell, so one
# instance's credentials never reach another's process.

# The label that names the destination directory under /var/lib/augur-backups/.
AUGUR_INSTANCE=example

# ── The bundle store copy ───────────────────────────────────────────────────
# The site's own origin, and a publish token that can read its manifests. This is
# deliberately the weakest credential that can do the work: no Cloudflare account
# access, and a restore then needs nothing but the directory and a token.
AUGUR_ORIGIN=https://augur.example.com
AUGUR_TOKEN=
# Unit ids whose absence from the copy is deliberate and understood — a
# space-scoped token cannot read `_engine`, and engine chrome rebuilds from a
# public repo at a recorded sha. Anything NOT listed here that cannot be read
# fails the run: a copy that quietly omits a space is the one you discover is
# short on the day you need it.
AUGUR_EXPECT_SKIPPED=

# ── The KV copy ─────────────────────────────────────────────────────────────
# Account credentials, because KV has no per-namespace token. The export they
# produce holds users:secrets and publish:tokens — it is a credential, and the
# script refuses to write it anywhere inside a git tree.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
AUGUR_KV_NS=
