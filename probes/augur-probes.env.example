# Copy to /etc/augur-probes.env, chmod 600. Never commit the real one.
#
# Every value here is a credential or an instance hostname. The example is the
# only version that belongs in git.

# ── Where alerts go ─────────────────────────────────────────────────────────
# Telegram is the channel this box already uses for machine alerts, so a probe
# alert lands in the same place as a disk-full alert and needs nothing installed.
TG_BOT_TOKEN=
TG_CHAT_ID=
# Optional second channel. A full ntfy publish URL, topic included.
NTFY_URL=

# ── The slow lane ───────────────────────────────────────────────────────────
# Minutes between end-to-end publish commits. Each one writes a new manifest
# version that is never pruned, so this is a dial, not a constant: 60 finds a
# broken publish path within the hour and adds ~24 versions a day to the
# rollback list. Lower it if publishing breaking matters more than a tidy
# rollback menu; raise it if the reverse.
COMMIT_EVERY_MIN=60

# Minutes between deploy-health passes (dirty publishes, chrome drift, engine
# staleness, free-tier quota burn). Read-only and slow — a GitHub compare and a
# Cloudflare GraphQL round trip per target — and it answers questions that change
# on the scale of hours. The three core probes stay at the cron's 3 minutes.
HEALTH_EVERY_MIN=360

# ── Which instances ─────────────────────────────────────────────────────────
TARGETS=example

# Per target, the prefix is T_<NAME UPPERCASED>_
T_EXAMPLE_ORIGIN=https://augur.example.com
# A substring only a genuinely composed page contains. The page title works:
# a Cloudflare error page and an empty build both fail it.
T_EXAMPLE_EXPECT=Example · Augur
# Space id, as it appears in /_build.json. Omit to skip the publish probes.
T_EXAMPLE_SPACE=example
# A publish token scoped to THAT SPACE, labelled so it is obvious in the admin
# panel. Mint it at /admin → tokens; never reuse a person's `augur login` token,
# which is star-scoped and can push the user list.
T_EXAMPLE_TOKEN=
# A dedicated VIEWER account. Viewers can sign in and can hold no publish token,
# so a leak of this pair costs a session and nothing else. Omit to skip login.
T_EXAMPLE_LOGIN_EMAIL=uptime-probe@example.com
T_EXAMPLE_LOGIN_PASS=

# The hourly end-to-end publish commit, per target. On by default. Set to 0 for an
# instance where a person publishes constantly and hourly probe-authored version
# bumps would be noise in THEIR history — the fast lane still exercises R2 reads
# and writes every three minutes, so what you give up is the CAS / composition /
# cache-purge coverage, not the store coverage.
T_EXAMPLE_COMMIT=1

# ── Deploy health, all opt-in ───────────────────────────────────────────────
# These answer "is this instance still being kept current", which nothing else
# does. They matter most for an instance whose CI cannot run: the site serves
# perfectly while the machinery that updates it has stopped, and no uptime probe
# can see the difference. Each is OFF unless set, and none of them ever colours a
# component on the public status page — a stale pin is not an outage.

# Seconds a working-tree ("dirty") publish may stand before it is a problem. Those
# exact bytes exist in no repository: nobody can review, rebuild or roll forward
# from them. 6h lets a hands-on session finish. 0 disables.
T_EXAMPLE_DIRTY_GRACE_SECONDS=21600
# Seconds a space may serve chrome older than the deployed engine. Must exceed the
# instance's own re-bake interval, or you alert on convergence in progress. 0 disables.
T_EXAMPLE_REBAKE_GRACE_SECONDS=28800
# How far the pinned engine may sit behind the PUBLIC engine's main. Unauthenticated
# GitHub compare, so no credential is needed here. 0 disables. Pick it from the
# engine's commit rate: it should mean "nobody has deployed in days", not "main moved".
# This is the one check that RE-NOTIFIES (weekly) instead of alerting once — an
# outage gets fixed because someone is already on it; a pin that stopped moving
# gets forgotten.
T_EXAMPLE_ENGINE_REPO=andratwiro/augur
T_EXAMPLE_ENGINE_MAX_BEHIND=50
# Free-tier daily quota burn, account-wide. Needs Account Analytics:Read — a token
# that can read usage counters and change nothing. This is the early warning for the
# outage class where KV reads run out and every login fails at once.
T_EXAMPLE_CF_TOKEN=
T_EXAMPLE_CF_ACCOUNT=
